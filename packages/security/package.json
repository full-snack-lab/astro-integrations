{
  "name": "@fullsnacklab/astro-security",
  "version": "0.2.0",
  "description": "Secure Astro CSP, dynamic response headers, and optional static asset headers.",
  "keywords": [
    "astro",
    "astro-integration",
    "content-security-policy",
    "security-headers",
    "cache-control"
  ],
  "homepage": "https://github.com/full-snack-lab/astro-integrations/tree/main/packages/security#readme",
  "bugs": {
    "url": "https://github.com/full-snack-lab/astro-integrations/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/full-snack-lab/astro-integrations.git",
    "directory": "packages/security"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cache": {
      "types": "./dist/cache.d.ts",
      "import": "./dist/cache.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "cd ../.. && bunup --filter astro-security",
    "test": "bun test",
    "type-check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "prepack": "bun run build"
  },
  "peerDependencies": {
    "astro": "^7.2.9"
  }
}
