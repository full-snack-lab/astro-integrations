{
  "name": "tremendous-transit",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "auth:migrate": "bun scripts/migrate-auth.ts",
    "auth:migrate:cloudflare": "wrangler d1 migrations apply DB --local",
    "auth:migrate:cloudflare:remote": "wrangler d1 migrations apply DB --remote",
    "dev": "astro dev",
    "build": "astro build",
    "build:cloudflare": "astro build --config astro.config.cloudflare.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.5",
    "@astrojs/node": "^11.1.4",
    "@astrojs/react": "^6.0.4",
    "@emdash-cms/cloudflare": "^0.35.0",
    "@fullsnacklab/astro-better-auth": "workspace:*",
    "@fullsnacklab/astro-cloudflare": "workspace:*",
    "@fullsnacklab/astro-emdash": "workspace:*",
    "@fullsnacklab/astro-flow": "workspace:*",
    "@fullsnacklab/astro-integration": "workspace:*",
    "@fullsnacklab/astro-security": "workspace:*",
    "@fullsnacklab/astro-theme": "workspace:*",
    "astro": "^7.2.9",
    "better-auth": "^1.7.2",
    "emdash": "^0.35.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "allowScripts": {
    "esbuild": true
  }
}
