---
const email = Astro.locals.user?.email ?? 'anonymous';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Better Auth playground</title>
	</head>
	<body>
		<h1>Astro Better Auth playground</h1>
		<p data-session={email}>{email}</p>
	</body>
</html>
