{
  "name": "astro-integrations",
  "private": true,
  "homepage": "https://github.com/full-snack-lab/astro-integrations#readme",
  "bugs": {
    "url": "https://github.com/full-snack-lab/astro-integrations/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/full-snack-lab/astro-integrations.git"
  },
  "workspaces": [
    "packages/*",
    "playground"
  ],
  "type": "module",
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "format": "oxfmt",
    "lint": "oxlint",
    "prepare": "bun simple-git-hooks",
    "changeset": "changeset",
    "release": "changeset publish",
    "test": "bun test",
    "test:coverage": "bun test --coverage",
    "test:watch": "bun test --watch",
    "type-check": "bun run --filter '*' type-check",
    "version-packages": "changeset version && bun update --lockfile-only --ignore-scripts @fullsnacklab/astro-better-auth @fullsnacklab/astro-cloudflare @fullsnacklab/astro-emdash @fullsnacklab/astro-flow @fullsnacklab/astro-integration @fullsnacklab/astro-security @fullsnacklab/astro-theme"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@emdash-cms/cloudflare": "^0.35.0",
    "@fullsnacklab/astro-better-auth": "workspace:*",
    "@fullsnacklab/astro-cloudflare": "workspace:*",
    "@fullsnacklab/astro-emdash": "workspace:*",
    "@fullsnacklab/astro-flow": "workspace:*",
    "@fullsnacklab/astro-integration": "workspace:*",
    "@fullsnacklab/astro-security": "workspace:*",
    "@fullsnacklab/astro-theme": "workspace:*",
    "@types/bun": "^1.4.0",
    "bunup": "^0.16.32",
    "emdash": "^0.35.0",
    "oxfmt": "^0.65.0",
    "oxlint": "^1.80.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run lint && bun run type-check"
  }
}
